# Copy to .env.production on the server. Never commit actual secrets.
PUBLIC_DOMAIN=drain.example.org
APP_ENV=production
ADMIN_USERNAME=operator
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
PUBLIC_BASE_URL=https://drain.example.org
DEVICE_TOKENS_JSON={"drain-01":"replace-with-unique-32-plus-character-random-token"}
LINE_CHANNEL_ACCESS_TOKEN=
ALERT_THRESHOLD=0.50
ALERT_COOLDOWN_MINUTES=15
MAX_IMAGE_MB=8
MAX_STORED_CAPTURES=100
CAPTURE_RETENTION_DAYS=1
MAX_CAPTURE_STORAGE_MB=100
MODEL_PATH=/app/models/drain_trash.pt
CLASS_MAP_JSON={"0":"trash"}
CONFIDENCE_THRESHOLD=0.35
