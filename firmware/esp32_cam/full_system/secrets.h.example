#pragma once

// Copy this file to secrets.h and fill in local values before compiling.
// Never commit secrets.h or share its contents in screenshots/chat.
// ESP32 joins your existing 2.4 GHz router/access point (Wi-Fi station mode).
// Enter the network name and password here; ESP32-CAM does not provide internet by itself.
static const char *WIFI_SSID = "YOUR_WIFI_SSID";
static const char *WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// API_HOST is hostname only: no https:// and no path.
static const char *API_HOST = "drain-watch-api.onrender.com";
static const uint16_t API_PORT = 443;
static const char *API_PATH = "/api/captures";
static const char *TELEMETRY_PATH = "/api/telemetry";

// Must match a device key in config/devices.json and DEVICE_TOKENS_JSON.
static const char *DEVICE_ID = "drain-01";
static const char *DEVICE_TOKEN = "replace-with-a-random-token-of-at-least-32-characters";

