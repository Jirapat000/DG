# Service
DATA_DIR=./data
DEVICE_CONFIG=./config/devices.json
ALERT_THRESHOLD=0.50
ALERT_COOLDOWN_MINUTES=15
MAX_IMAGE_MB=8

# Model: detector weights shipped with this project (bounding-box coverage estimate)
MODEL_PATH=./models/drain_trash.pt
CLASS_MAP_JSON={"0":"trash"}
CONFIDENCE_THRESHOLD=0.35

# Optional upload authentication: {"drain-01":"replace-with-long-random-token"}
DEVICE_TOKENS_JSON={}

# Optional LINE Messaging API broadcast alert settings (all OA friends)
LINE_CHANNEL_ACCESS_TOKEN=
